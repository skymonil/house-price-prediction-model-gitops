                      "datasource": {
                        "name": "prometheus"
                      },
                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(\n  rate(http_requests_total{\n    namespace=\"applications\",\n    service=\"house-price-api\"\n  }[5m])\n)",
                        "legendFormat": "Total requests/sec",
                        "range": true
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {
                "minInterval": "15s"
              },
              "transformations": []
            }
