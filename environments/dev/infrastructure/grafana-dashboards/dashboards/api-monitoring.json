                      "group": "prometheus",
                      "kind": "DataQuery",
                      "spec": {
                        "editorMode": "code",
                        "expr": "sum(\n  increase(http_requests_total{\n    namespace=\"applications\",\n    service=\"house-price-api\",\n    handler=\"/predict\",\n    status=\"2xx\"\n  }[15m])\n)",
